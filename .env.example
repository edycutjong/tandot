# ============================================================
# Tandot — Environment Variables
# ============================================================
# Copy this file to .env.local and fill in your values:
#   cp .env.example .env.local

# ── Supabase ─────────────────────────────────────────────────
# Get from: https://supabase.com/dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
# Get from: https://supabase.com/dashboard → Project Settings → API → service_role (secret)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ── Bitso Business API ───────────────────────────────────────
# ⚠️  Use STAGING for development/hackathon — never production
# Get from: https://stage.bitso.com → API Keys
# Production (later): https://bitso.com → API Keys
BITSO_API_KEY=your-bitso-api-key
BITSO_API_SECRET=your-bitso-api-secret
BITSO_API_URL=https://stage.bitso.com

# ── OpenAI (Trust Scoring / Fraud Detection) ─────────────────
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-key-here

# ── Arbitrum (Smart Contract) ────────────────────────────────
# Get from: Deploy via Hardhat — see contracts/README.md
NEXT_PUBLIC_ESCROW_CONTRACT_ADDRESS=0x...your-contract-address
NEXT_PUBLIC_MXNB_TOKEN_ADDRESS=0x...your-token-address
# Get from: https://dashboard.alchemy.com → Create App → Arbitrum Sepolia
ARBITRUM_RPC_URL=https://arb-sepolia.g.alchemy.com/v2/your-key

